# Copy to .env (never commit .env). scripts/import-export.sh writes .env for you from the encrypted export.
# Public hostname of the CRM. Without a domain, use sslip.io with the server IP: crm.<ip with dashes>.sslip.io
CRM_HOST=crm.203-0-113-10.sslip.io
# Twenty version: MUST be the version the data was exported from (version.txt in the export). Upgrade only after it runs.
TAG=v0.0.0
# Database password for this server only. Use HEX (letters and digits only, it goes inside a URL): openssl rand -hex 24
PG_DATABASE_PASSWORD=
# These two MUST be the values of the CRM the data came from (secrets.env in the export).
# Different values = logins, API keys and the connected mailbox stop working.
APP_SECRET=
ENCRYPTION_KEY=
FALLBACK_ENCRYPTION_KEY=
# true = nobody can create an account without an invite link. Set false ONLY to create the very first Admin, then back to true.
IS_SIGN_UP_DISABLED=true
